PORT=8096
DB_HOST=localhost
DB_PORT=15446
DB_NAME=pago_db
DB_USERNAME=eduspace
DB_PASSWORD=eduspace
CONFIG_SERVER_URL=http://localhost:18888
EUREKA_URI=http://localhost:18761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
JWK_SET_URI=http://localhost:8090/.well-known/jwks.json
TZ=America/Lima


# Mercado Pago (pasarela real). Sin MERCADOPAGO_ACCESS_TOKEN sigue activa la pasarela de demostración.
# Las credenciales van SOLO en services/pago-ms/.env (ignorado por git), nunca en el repositorio.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS a la que Mercado Pago envía los avisos (en desarrollo, un túnel: ngrok, cloudflared…)
PAGO_PUBLIC_BASE_URL=
PAGO_FRONTEND_URL=http://localhost:4200
